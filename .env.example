# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/pos-fi?retryWrites=true&w=majority

# JWT secret key (dùng chuỗi random dài ít nhất 32 ký tự)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# JWT expiry (8 giờ cho một ca làm việc)
JWT_EXPIRES_IN=8h

# Server port
PORT=5000

# URL của FE (cho CORS) - có thể điền nhiều URL phân cách bằng dấu phẩy
# Ví dụ production: CLIENT_URL=https://pos-fi.vercel.app,https://pos-fi.netlify.app
CLIENT_URL=http://localhost:3000
